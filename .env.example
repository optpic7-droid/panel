# =============================================================================
# Petro Panel installer configuration
# Copy to ".env" and adjust:  cp .env.example .env && nano .env
# Everything here can also be supplied as real environment variables.
# Variables left empty are either auto-generated (passwords) or prompted for.
# =============================================================================

# ---- Upstream versions (pinned, tested together) ---------------------------
# Pterodactyl Panel release tag: https://github.com/pterodactyl/panel/releases
PANEL_VERSION="v1.11.10"
# Wings release tag: https://github.com/pterodactyl/wings/releases
WINGS_VERSION="v1.13.4"
# PHP minor version provided by sury.org / ondrej PPA
PHP_VERSION="8.3"

# ---- Panel web endpoint -----------------------------------------------------
# Fully qualified domain name that points at THIS server's public IP.
# An IP address is allowed when PANEL_SSL=false (no public cert for bare IPs).
PANEL_FQDN="panel.example.com"
# Port Nginx listens on. 80 is the standard HTTP port; set a custom value
# (e.g. 8088) to run the panel on http://PANEL_FQDN:8088 without a domain.
# Let's Encrypt requires port 80, so PANEL_SSL is forced off for custom ports.
PANEL_PORT="80"
# Issue a Let's Encrypt certificate and force HTTPS (true/false).
PANEL_SSL="true"
LETSENCRYPT_EMAIL="admin@example.com"
TIMEZONE="UTC"

# ---- Panel admin account ----------------------------------------------------
ADMIN_USERNAME="admin"
ADMIN_FIRSTNAME="Panel"
ADMIN_LASTNAME="Admin"
ADMIN_EMAIL="admin@example.com"
# Empty = a 24-char password is generated and printed at the end of the install.
ADMIN_PASSWORD=""

# ---- MariaDB ----------------------------------------------------------------
DB_NAME="panel"
DB_USER="pterodactyl"
# Empty = a 40-char password is generated and stored in /root/.petro-panel.env
DB_PASSWORD=""

# ---- Node (Wings) settings --------------------------------------------------
# Short/long location the node is grouped under (created automatically).
LOCATION_SHORT="loc1"
LOCATION_LONG="Default location"
NODE_NAME="node-1"
# Public hostname or IP of the machine Wings runs on. Use an IP for local tests.
NODE_FQDN="node.example.com"
# http or https (https requires a certificate on the node / behind_proxy).
NODE_SCHEME="https"
# Set true when TLS is terminated by a reverse proxy in front of Wings.
NODE_BEHIND_PROXY="false"
# Resource limits in MiB. 0 = unlimited. Overallocate is allowed extra %.
NODE_MEMORY="8192"
NODE_MEMORY_OVERALLOCATE="0"
NODE_DISK="20480"
NODE_DISK_OVERALLOCATE="0"
NODE_DAEMON_PORT="8080"
NODE_SFTP_PORT="2022"
NODE_UPLOAD_LIMIT="100"
# Allocation that game servers can bind to. Usually the node's public IP.
ALLOCATION_IP="node.example.com"
# Comma separated list or port ranges, e.g. "25565,25570-25575,27015".
ALLOCATION_PORTS="25565,25570-25575"

# ---- connect-node authentication -------------------------------------------
# Base URL of the panel as reachable from the node (no trailing slash).
PANEL_URL="https://panel.example.com"
# Application API key (starts with ptla_) created in Admin -> Application API.
# Required by scripts/30-connect-node.sh. The key needs write access to
# locations, nodes and allocations.
APPLICATION_API_KEY=""

# ---- Install paths (defaults match official Pterodactyl docs) ---------------
PANEL_PATH="/var/www/pterodactyl"
WINGS_CONFIG_PATH="/etc/pterodactyl"
WINGS_DATA_PATH="/var/lib/pterodactyl/volumes"
