# Example Wings configuration. Normally you never edit this by hand:
# scripts/30-connect-node.sh (or `wings configure`) generates /etc/pterodactyl/config.yml
# from the panel's Application API. Documented here for reference.
debug: false
uuid: 00000000-0000-4000-8000-000000000000
token_id: "ptla-example-token-id"
token: "example-decrypted-daemon-token"
api:
  host: 0.0.0.0
  port: 8080
  ssl:
    enabled: false
    cert: /etc/letsencrypt/live/node.example.com/fullchain.pem
    key: /etc/letsencrypt/live/node.example.com/privkey.pem
  upload_limit: 100
system:
  data: /var/lib/pterodactyl/volumes
  sftp:
    bind_port: 2022
allowed_mounts: []
remote: https://panel.example.com
